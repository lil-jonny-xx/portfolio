# All optional. Defaults live in src/data/site.ts. Set these in Vercel → Project → Settings → Environment Variables.
# An empty value hides every link that uses it.

# Production origin, no trailing slash. Used for canonical URLs, sitemap.xml, robots.txt and Open Graph.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# "/resume.pdf" after adding public/resume.pdf, or a full URL.
NEXT_PUBLIC_RESUME_URL=

# Short, true statement shown in the contact section, e.g. "Open to summer 2027 internships". Leave empty to hide.
NEXT_PUBLIC_AVAILABILITY=
